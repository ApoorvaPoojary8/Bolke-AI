# ============================================================
# BolKe — .gitignore
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnpm-store/
.yarn/

# ── Secrets & Environment ────────────────────────────────────
.env
.env.*
.env.local
.env.production
!.env.example

# Google / GCP service accounts
service-account.json
*.json.key

# ── Build Artifacts ──────────────────────────────────────────
dist/
build/
out/
.output/
apps/web/dist/
apps/backend/dist/

# TypeScript incremental build cache
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / System ──────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── AI / Agent Tool Directories ─────────────────────────────
# These are local AI-assistant runtime dirs — not project code
.agents/
.cursor/
.jetro/
.windsurfrules
.mcp.json
AGENT.md
CLAUDE.md

# GitHub Copilot local config
.github/copilot-instructions.md

# ── Test / Coverage ──────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Vite / Rollup Cache ───────────────────────────────────────
.vite/
vite.config.js.timestamp-*

# ── Supabase local ───────────────────────────────────────────
supabase/.temp/
supabase/functions/.deno/

# ── LiveKit / Media temp ─────────────────────────────────────
*.webm
*.mp4
*.ogg
*.wav
tmp/

# ── Misc ─────────────────────────────────────────────────────
*.tgz
*.zip
.cache/
