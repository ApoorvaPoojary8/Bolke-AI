# ============================================
# BolKe Backend — Environment Variables Template
# ============================================
# Copy this to .env and replace placeholder values.

# ── AI Provider Keys ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-PASTE_YOUR_KEY_HERE
CLAUDE_PRIMARY_MODEL=claude-haiku-4-5-20251001
CLAUDE_ESCALATION_MODEL=claude-sonnet-4-6
GROQ_API_KEY=gsk_PASTE_YOUR_KEY_HERE

# ── Google Cloud (STT + TTS) ──────────────────
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ── Supabase ──────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJ...PASTE_YOUR_SERVICE_ROLE_KEY_HERE

# ── Auth ──────────────────────────────────────
JWT_SECRET=generate_with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ── Server ────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── n8n Webhooks (optional) ───────────────────
N8N_WEBHOOK_SECRET=change_this_to_a_random_64_char_string
N8N_RATION_WEBHOOK=https://your-n8n-instance.com/webhook/ration-status
N8N_HOSPITAL_WEBHOOK=https://your-n8n-instance.com/webhook/hospital-lookup
N8N_PENSION_WEBHOOK=https://your-n8n-instance.com/webhook/pension-eligibility
N8N_DIGILOCKER_WEBHOOK=https://your-n8n-instance.com/webhook/digilocker
